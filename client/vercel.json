{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://remarks-landscape-chemicals-victor.trycloudflare.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://remarks-landscape-chemicals-victor.trycloudflare.com/uploads/$1"
    },
    {
      "source": "/brand/(.*)",
      "destination": "https://remarks-landscape-chemicals-victor.trycloudflare.com/brand/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
