{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ras-brother-tour-travels.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://ras-brother-tour-travels.onrender.com/uploads/$1"
    },
    {
      "source": "/brand/(.*)",
      "destination": "https://ras-brother-tour-travels.onrender.com/brand/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
