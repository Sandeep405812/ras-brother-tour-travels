{
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://goto-composer-bachelor-original.trycloudflare.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://goto-composer-bachelor-original.trycloudflare.com/uploads/$1"
    },
    {
      "source": "/brand/(.*)",
      "destination": "https://goto-composer-bachelor-original.trycloudflare.com/brand/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
